{
  "name": "dusk",
  "version": "1.0.1",
  "private": true,
  "description": "Smart night-time dark mode for Chrome",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/*.test.ts",
    "e2e": "node scripts/build.mjs && node test/e2e/run.mjs",
    "icons": "node scripts/icons.mjs",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
